{
  "$schema": "https://raw.githubusercontent.com/spetersenms/AL-Go/spetersen-microsoft-separate-test-action-investigation/Actions/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/spetersenms/AL-Go@spetersen-microsoft-separate-test-action-investigation",
  "generateDependencyArtifact": true,
  "DeployToProduction": {
    "environmentName": "AL-Go-Demo-Test"
  },
  "templateSha": "060d6b293c1e89557fd2e8914accbe284c4aafe2",
  "enableCodeCop": true,
  "enableUICop": true,
  "rulesetFile": "../rulesets/ruleset.json",
  "trackAlAlertsInGitHub": true,
  "useProjectDependencies": true,
  "buildModes": [],
  "artifact": "//26//latest",
  "enableCodeCoverage": true,
  "useSeparateTestAction": true,
  "codeCoverageSetup": {
    "trackingType": "PerRun",
    "produceCodeCoverageMap": "PerCodeunit",
