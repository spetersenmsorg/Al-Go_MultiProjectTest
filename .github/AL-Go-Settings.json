{
  "$schema": "https://raw.githubusercontent.com/spetersenms/AL-Go/spetersen/separateTestAction-codecoverage/Actions/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/spetersenms/AL-Go@spetersen/separateTestAction-codecoverage",
  "generateDependencyArtifact": true,
  "DeployToProduction": {
    "environmentName": "AL-Go-Demo-Test"
  },
  "templateSha": "440a10cac5db404404334a4b23f225c197643971",
  "enableCodeCop": true,
  "enableUICop": true,
  "rulesetFile": "../rulesets/ruleset.json",
  "trackAlAlertsInGitHub": true,
  "useProjectDependencies": true,
  "buildModes": [],
  "artifact": "//26//latest",
  "enableCodeCoverage": true,
  "useSeparateTestAction": true,
  "codeCoverageSetup": {
    "trackingType": "PerRun",
    "produceCodeCoverageMap": "PerCodeunit",
    "excludeFilesPattern": [
      "*.PermissionSet.al"
    ]
  }
}
