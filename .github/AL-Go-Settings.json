{
  "$schema": "https://raw.githubusercontent.com/spetersenms/AL-Go/spetersen-microsoft-renewal-coverage-compatibility/Actions/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/spetersenms/AL-Go@spetersen-microsoft-renewal-coverage-compatibility",
  "generateDependencyArtifact": true,
  "enableCodeCop": true,
  "enableUICop": true,
  "rulesetFile": "../rulesets/ruleset.json",
  "trackAlAlertsInGitHub": true,
  "useProjectDependencies": false,
  "buildModes": [],
  "artifact": "bcinsider//30//latest",
  "useSeparateTestAction": {
    "enabled": true,
    "codeCoverageEnabled": true,
    "codeCoverageGenerateCobertura": true,
    "codeCoverageSummary": "both"
  }
}
